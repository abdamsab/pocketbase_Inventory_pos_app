  // Rollback migration
  const collectionsToDrop = ['audit_logs', 'audit_retention_policies', 'audit_alerts'];

  collectionsToDrop.forEach(collectionName => {
    try {
      const collection = db.findCollectionByNameOrId(collectionName);
      if (collection) {
        db.dropCollection(collection);
      }
    } catch (error) {
      console.warn(`Could not drop collection ${collectionName}:`, error);
    }
  });

  // Remove audit fields from collections
  const sensitiveCollections = ['users', 'sales', 'products', 'settings'];

  sensitiveCollections.forEach(collectionName => {
    try {
      const collection = db.findCollectionByNameOrId(collectionName);
      if (collection) {
        collection.schema = collection.schema.filter(field =>
          field.name !== 'audit_trail' &&
          field.name !== 'last_modified_by' &&
          field.name !== 'modification_reason'
        );
        db.saveCollection(collection);
      }
